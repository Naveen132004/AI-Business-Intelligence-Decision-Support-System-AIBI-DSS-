# Copy to .env on the server and fill in. Never commit .env.
#   cp .env.example .env

# Address people will open in the browser (used for CORS). Examples:
#   http://203.0.113.10      https://aibi.example.com
PUBLIC_URL=http://localhost

# Port the site is served on (80 for a normal server)
HTTP_PORT=80

# Database — use letters and digits only for the password (it is
# embedded in a connection URL). Generate one with:  openssl rand -hex 24
POSTGRES_DB=aibi_db
POSTGRES_USER=aibi_user
POSTGRES_PASSWORD=

# Signing key for login tokens, at least 32 characters:  openssl rand -hex 32
JWT_SECRET=

# Optional — enables the RAG assistant. https://aistudio.google.com/apikey
GEMINI_API_KEY=
